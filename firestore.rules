rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- helpers seguros (no explotan si falta el doc) --------
    function isAuthed() { return request.auth != null; }

    function hasProfile() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function userOrg() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId
        : null;
    }

    function isSuperAdmin() { return userRole() == 'SUPER_ADMIN'; }
    function isOrgAdmin()  { return userRole() == 'ORG_ADMIN'; }

    // ---------------------- USERS ----------------------
    match /users/{userId} {
      allow get: if isAuthed() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isOrgAdmin() && userOrg() == resource.data.organizationId)
      );

      allow list: if isAuthed() && (isSuperAdmin() || isOrgAdmin());
      allow create: if isAuthed() && request.auth.uid == userId;

      allow update: if isAuthed() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isOrgAdmin() && userOrg() == resource.data.organizationId)
      );

      allow delete: if isAuthed() && request.auth.uid != userId && (
        isSuperAdmin() ||
        (isOrgAdmin() && userOrg() == resource.data.organizationId)
      );
    }

    // ------------------ INVITATIONS --------------------
    match /invitations/{invitationId} {
      allow create, get: if isAuthed() && (isSuperAdmin() || isOrgAdmin());
      allow get, delete: if isAuthed() && request.auth.token.email == invitationId;
    }

    // ------------------ ORGANIZATIONS ------------------
    match /organizations/{orgId} {
      allow get: if isAuthed() && (isSuperAdmin() || userOrg() == orgId);
      allow list, write: if isAuthed() && isSuperAdmin();
    }

    // ---------------------- QUOTA ----------------------
    // id = "<orgId>__<uid>__<YYYYMM>"
    match /quota/{id} {
      function parts() { return id.split("__"); }
      function uidFromId() { return parts()[1]; }
      allow read: if isAuthed() && request.auth.uid == uidFromId();
      // solo las Functions pueden crear/actualizar (bandera _byFn)
      allow create, update: if isAuthed() &&
        request.auth.uid == uidFromId() &&
        request.resource.data._byFn == true;
      allow delete: if false;
    }

    // -------- GENERIC (items, transactions, controlRecords, locations, etc.) --------
    match /{collection}/{docId} {
      allow list: if isAuthed();

      allow get: if isAuthed() && (
        isSuperAdmin() || userOrg() == resource.data.organizationId
      );

      allow create: if isAuthed() && (
        isSuperAdmin() || userOrg() == request.resource.data.organizationId
      );

      allow update, delete: if isAuthed() && (
        isSuperAdmin() || userOrg() == resource.data.organizationId
      );
    }
  }
}
