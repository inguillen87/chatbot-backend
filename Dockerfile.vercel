FROM python:3.12-slim

ARG INSTALL_OPEN_SOURCE_AI_EXTRAS=false

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    GUNICORN_WORKERS=1 \
    GUNICORN_THREADS=32 \
    GUNICORN_TIMEOUT=300

WORKDIR /app

# Keep the Vercel web container free of FFmpeg until a reachable runtime flow
# requires it. WhatsApp audio is sent directly to provider STT, while the
# legacy video-frame helpers have no production caller. Render retains FFmpeg
# through build.sh for its separate runtime contract.

COPY requirements.txt requirements-ai-oss.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ "${INSTALL_OPEN_SOURCE_AI_EXTRAS:-false}" = "true" ]; then \
         pip install --no-cache-dir -r requirements-ai-oss.txt; \
       fi

COPY . .

# Require the actual container context to contain each official boundary with
# its declared digest. Missing files or mismatches must fail the Vercel build.
RUN python -c "import hashlib, json, sys; from pathlib import Path; \
    configs = [Path('data/municipios/junin/geo.json'), Path('data/tenants/tierra-del-fuego/geo.json')]; \
    snapshots = [(path.parent, json.loads(path.read_text(encoding='utf-8'))['boundary']) for path in configs]; \
    mismatches = [str(base / spec['file']) for base, spec in snapshots if hashlib.sha256((base / spec['file']).read_bytes()).hexdigest() != spec['snapshot_sha256']]; \
    sys.exit('Corrupt official boundary snapshot in container: ' + ', '.join(mismatches)) if mismatches else None"

# Bake application bytecode into the immutable image. The runtime intentionally
# disables bytecode writes, so without this step every cold instance recompiles
# the full Flask route tree before Gunicorn can become ready.
RUN python -m compileall -q -j 0 /app

RUN mkdir -p /app/instance /app/logs /app/temp_uploads /tmp/chatboc

CMD ["sh", "-c", "if [ -n \"${GOOGLE_SERVICE_ACCOUNT_JSON:-}\" ]; then umask 077; printf '%s' \"$GOOGLE_SERVICE_ACCOUNT_JSON\" > /tmp/google_service_key.json; export GOOGLE_APPLICATION_CREDENTIALS=/tmp/google_service_key.json; fi; exec gunicorn --config gunicorn.conf.py --bind 0.0.0.0:${PORT:-80} bootstrap_wsgi:application"]
