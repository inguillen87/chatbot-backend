@host = https://api.chatboc.ar
@token = REPLACE_WITH_BEARER_TOKEN

### 🔐 Login
POST {{host}}/login
Content-Type: application/json

{
  "email": "REPLACE_WITH_EMAIL",
  "password": "REPLACE_WITH_PASSWORD"
}

###

### 🆕 Registro
POST {{host}}/register
Content-Type: application/json

{
  "name": "REPLACE_WITH_NAME",
  "email": "REPLACE_WITH_EMAIL",
  "password": "REPLACE_WITH_PASSWORD",
  "nombre_empresa": "REPLACE_WITH_COMPANY",
  "rubro": "REPLACE_WITH_RUBRO"
}

###

### 👤 Obtener perfil (/me)
GET {{host}}/me
Authorization: Bearer {{token}}

###

### 📋 Obtener perfil completo (/perfil)
GET {{host}}/perfil
Authorization: Bearer {{token}}

###

### ✏️ Actualizar perfil
PUT {{host}}/perfil
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre_empresa": "Cuatro Fincas Winery",
  "direccion": "Ruta 89, Mendoza",
  "telefono": "2611234567",
  "link_web": "https://cuatrofincas.com",
  "horario": "Lunes a Sábado de 9 a 18",
  "ubicacion": "Tunuyán, Mendoza",
  "logo_url": "https://cuatrofincas.com/logo.png"
}

###

### 💬 Probar el chatbot
POST {{host}}/responder_chatboc
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pregunta": "quiero comprar vinos?",
  "rubro": "Bodega"
}
