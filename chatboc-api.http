@host = https://api.chatboc.ar
@token = e497eb24-69d5-4551-852c-c9a0a3b1213a

### 🔐 Login
POST {{host}}/login
Content-Type: application/json

{
  "email": "demo@demo.com",
  "password": "marcemarce"
}

###

### 🆕 Registro
POST {{host}}/register
Content-Type: application/json

{
  "name": "Marcelo",
  "email": "demo@demo.com",
  "password": "123456",
  "nombre_empresa": "Chatboc",
  "rubro": "Bodega"
}

###

### 👤 Obtener perfil (/me)
GET {{host}}/me
Authorization: Bearer {{token}}

###

### 📋 Obtener perfil completo (/perfil)
GET {{host}}/perfil
Authorization: Bearer {{token}}

###

### ✏️ Actualizar perfil
PUT {{host}}/perfil
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre_empresa": "Cuatro Fincas Winery",
  "direccion": "Ruta 89, Mendoza",
  "telefono": "2611234567",
  "link_web": "https://cuatrofincas.com",
  "horario": "Lunes a Sábado de 9 a 18",
  "ubicacion": "Tunuyán, Mendoza",
  "logo_url": "https://cuatrofincas.com/logo.png"
}

###

### 💬 Probar el chatbot
POST {{host}}/responder_chatboc
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pregunta": "quiero comprar vinos?",
  "rubro": "Bodega"
}
