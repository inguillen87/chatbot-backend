# Ignora todo el contenido de instance, menos la carpeta en sí
instance/*
!instance/.gitkeep   # Un archivo vacío solo para mantener la carpeta en git

# Ignora datos sensibles y claves
.env
/data/*.json
*.json
!data/tramites.json
!data/respuestas_municipio.json
!data/product_synonyms.json
!data/municipios/**
!data/numeros_whatsapp.json
__pycache__/
*.pyc
venv/
sandbox_venv/

# Pero permite que la estructura instance/ exista
