!data/respuestas_municipio.json
!data/product_synonyms.json
!data/estacionamiento/camaras.json
!data/municipios/**
__pycache__/
*.pyc
venv/
.venv/
env/
venv/
test_venv/
sandbox_venv/

# Pero permite que la estructura instance/ exista
node_modules
!data/estacionamiento/camaras.json
