## Core runtime
ENV=dev
SECRET_KEY=replace-with-a-long-random-secret
# Required for public TenantTicket receipts and T- tracking. Use at least 32
# random bytes and keep it independent from SECRET_KEY. Never expose it client-side.
TENANT_CLAIM_RECEIPT_SECRET_V1=
DEBUG=false
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
# Network DB waits are bounded independently from the readiness SELECT timeout.
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATABASE_POOL_TIMEOUT_SECONDS=2
# Keep pools small on autoscaled runtimes; size applies per warm instance.
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
# Use rediss:// managed Redis in Render; memory:// is development-only.
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
READINESS_DATABASE_TIMEOUT_SECONDS=1.5
READINESS_REDIS_TIMEOUT_SECONDS=1.0
READINESS_CACHE_TTL_SECONDS=1.0
# Vercel/container alternative to a mounted Google credentials secret file.
# The entrypoint writes it with mode 0600 to /tmp at runtime.
GOOGLE_SERVICE_ACCOUNT_JSON=

## AI providers
OPENAI_API_KEY=
# Rollout evidence gate: set true only after a controlled live provider smoke
# succeeds for the deployed project/key. Key presence alone is not readiness.
OPENAI_PROVIDER_LIVE_VERIFIED=false
OPENAI_PROVIDER_LIVE_VERIFIED_AT=
OPENAI_CHAT_MODEL_DEFAULT=gpt-5.6-sol
OPENAI_CHAT_MODEL_WHATSAPP=gpt-5.6-terra
OPENAI_CHAT_MODEL_WIDGET=gpt-5.6-terra
OPENAI_CHAT_MODEL_HIGH_COMPLEXITY=gpt-5.6-sol
OPENAI_CHAT_MODEL_EXTRACTION=gpt-5.6-terra
OPENAI_WHATSAPP_AGENT_MODEL=gpt-5.6-terra
OPENAI_CLAIM_AGENT_MODEL=gpt-5.6-sol
OPENAI_VOICE_AGENT_MODEL=gpt-5.6-terra
OPENAI_ANALYTICS_MODEL=gpt-5.6-terra
OPENAI_SENTIMENT_MODEL=gpt-5.6-terra
OPENAI_TICKET_SUMMARY_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_MENU_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_SPEECH_MODEL=gpt-realtime-2.1
OPENAI_LIVE_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_INPUT_TRANSCRIPTION_MODEL=gpt-4o-transcribe
LLM_PROVIDER_ORDER=openai,gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_CHAT_API_VERSION=v2
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_ENABLED=false
HUGGINGFACE_PROVIDER=auto
HUGGINGFACE_EMBEDDINGS_ENABLED=false
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-large
HUGGINGFACE_ZERO_SHOT_ENABLED=false
HUGGINGFACE_ZERO_SHOT_MODEL=joeddav/xlm-roberta-large-xnli
HUGGINGFACE_RECLAMO_CATEGORY_MIN_SCORE=0.72
HUGGINGFACE_RECLAMO_PRIORITY_MIN_SCORE=0.66
HUGGINGFACE_RECLAMO_SIGNAL_MIN_SCORE=0.62
HUGGINGFACE_SENTIMENT_MIN_SCORE=0.56
HUGGINGFACE_PYME_INTENT_MIN_SCORE=0.62
VISION_HUGGINGFACE_ENABLED=false
HUGGINGFACE_IMAGE_CLASSIFICATION_MODEL=google/vit-base-patch16-224
HUGGINGFACE_OBJECT_DETECTION_MODEL=facebook/detr-resnet-50
INSTALL_OPEN_SOURCE_AI_EXTRAS=false
DOCLING_ENABLED=false
DOCLING_MAX_FILE_MB=15

## Demo mode (disabled by default; enable explicitly in non-production)
ENABLE_DEMO_MODE=false
DEMO_SESSION_SECRET=replace-with-a-different-long-random-secret
# Required only when creating these tenant admins from seed/CLI commands.
JUNIN_ADMIN_BOOTSTRAP_PASSWORD=
SERVILL_ADMIN_BOOTSTRAP_PASSWORD=
DEMO_WIDGET_TOKEN_JUNIN=

## Clerk Auth
CLERK_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
# Canonical Clerk webhook signing secret. CLERK_WEBHOOK_SECRET remains a legacy alias.
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_WEBHOOK_SECRET=
CLERK_AUTHORIZED_PARTIES=https://chatboc.ar,https://www.chatboc.ar
CLERK_REQUIRE_AZP=true
CLERK_SUPERADMIN_EMAILS=guillen.marce@gmail.com
CLERK_REVOKED_SESSION_TTL_SECONDS=86400
CHATBOC_TERMS_VERSION=2026-07-11
# Enable only after each provider is configured in the Chatboc Clerk project.
CLERK_SOCIAL_PROVIDERS=
LIVE_CHAT_ROOM_TOKEN_TTL_SECONDS=900
TRACKING_FAILURE_RATE_LIMIT_ATTEMPTS=5
TRACKING_SUBJECT_FAILURE_RATE_LIMIT_ATTEMPTS=20
TRACKING_FAILURE_RATE_LIMIT_WINDOW_SECONDS=60
# Compatibility-only JSON inspection at global auth/identity middleware. New
# clients should carry auth and contact identity in headers. Larger or
# content-length-less bodies are left untouched for the route-level parser.
AUTH_TOKEN_JSON_BODY_MAX_BYTES=65536
CONTACT_IDENTITY_JSON_BODY_MAX_BYTES=65536

## WhatsApp template safety
# Optional reviewed emergency override. Keep empty unless its current provider
# approval and variable contract were verified; API acceptance is not delivery.
WELCOME_TEMPLATE_SID=
WELCOME_TEMPLATE_OVERRIDE_ENABLED=false
# Local approval manifests older than this are ignored. Within an active
# 24-hour WhatsApp window, configured pre-messages may use their text fallback.
TWILIO_TEMPLATE_MANIFEST_MAX_AGE_HOURS=168
WELCOME_MESSAGE_DELAY_SECONDS=5

## WhatsApp inclusive audio menus / Cloudflare cache
TTS_CACHE_ENABLED=true
WHATSAPP_MENU_AUDIO_ENABLED=true
TTS_AUDIO_CACHE_PUBLIC_BASE_URL=
CLOUDFLARE_AUDIO_CACHE_PUBLIC_BASE_URL=

## Cloudflare R2 assets
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_SIGNED_URL_TTL_SECONDS=900

## Cloudflare Turnstile public intake protection
# Server-side secret only. For local smoke tests Cloudflare publishes a dummy
# pass key: 1x0000000000000000000000000000000AA. Do not use dummy keys in prod.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Keep false until VITE_CLOUDFLARE_TURNSTILE_SITE_KEY is deployed on frontend
# and this backend has a real CLOUDFLARE_TURNSTILE_SECRET_KEY. When true
# without a secret, public intake fails closed.
CLOUDFLARE_TURNSTILE_ENFORCE_PUBLIC_INTAKE=false

## Public API used by Meta and Twilio callbacks
PUBLIC_API_BASE_URL=https://api.chatboc.ar

## Meta WhatsApp Flows / Data API 3.0
# Use one generated secret across Flow issuance, Data Exchange and completion
# webhooks. Never commit or log the production value.
WHATSAPP_FLOW_TOKEN_KEY_V1=
WHATSAPP_FLOW_TOKEN_TTL_SECONDS=172800
META_FLOW_DATA_EXCHANGE_MAX_PAYLOAD_BYTES=65536
# System User token with whatsapp_business_management. A WABA-specific token
# (META_FLOW_WABA_<WABA_NORMALIZED>_ACCESS_TOKEN) takes precedence.
META_GRAPH_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_TIMEOUT_SECONDS=20
# Per-WABA transport secrets are configured only after the real WABA is known:
# META_FLOW_WABA_<WABA_NORMALIZED>_ACCESS_TOKEN=
# META_FLOW_WABA_<WABA_NORMALIZED>_PRIVATE_KEY_PEM=
# META_FLOW_WABA_<WABA_NORMALIZED>_PRIVATE_KEY_PASSPHRASE=
# META_FLOW_WABA_<WABA_NORMALIZED>_APP_SECRET=
# META_FLOW_WABA_<WABA_NORMALIZED>_PREVIOUS_APP_SECRET=
# Compatibility fallback only; prefer WHATSAPP_FLOW_TOKEN_KEY_V1 globally.
# META_FLOW_WABA_<WABA_NORMALIZED>_FLOW_TOKEN_KEY_V1=

## Twilio / Meta Tech Provider onboarding
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Media Streams authorization. Prefer a dedicated random secret of at
# least 32 bytes; when blank, a domain-separated key is derived from
# TWILIO_AUTH_TOKEN. Never expose either value in TwiML or logs.
VOICE_STREAM_SIGNING_SECRET=
VOICE_STREAM_ENVELOPE_TTL_SECONDS=120
VOICE_STREAM_PREFLIGHT_TIMEOUT_SECONDS=5
VOICE_STREAM_PREFLIGHT_MAX_EVENTS=3
VOICE_STREAM_PREFLIGHT_MAX_MESSAGE_BYTES=32768
# Optional dedicated shared Redis/Redis-TLS store for one-time envelope
# consumption. When blank, runtime reuses SOCKETIO_MESSAGE_QUEUE_URL (or
# SOCKETIO_REDIS_URL / an explicitly exported CELERY_BROKER_URL). Runtime fails
# closed when none is configured or reachable.
VOICE_STREAM_REPLAY_REDIS_URL=
# Unit tests only. Runtime must never use the process-local replay store.
VOICE_STREAM_REPLAY_ALLOW_IN_MEMORY_TEST_STORE=false
# Requires migration 20260730_voice_consent_v1 and an explicit per-tenant
# voice_consent_policy. When false/missing no Media Stream or OpenAI bridge opens.
ENABLE_VOICE_CONSENT_LIFECYCLE_V1=false
# Dedicated E.164 PSTN caller ID enabled for Twilio Voice callbacks. This must
# not be the WhatsApp sender unless that same number is explicitly voice-enabled.
TWILIO_VOICE_PHONE_NUMBER=
TWILIO_META_APP_ID=
TWILIO_META_EMBEDDED_SIGNUP_CONFIG_ID=
TWILIO_PARTNER_SOLUTION_ID=
TWILIO_TECH_PROVIDER_LIVE_ENABLED=false
TWILIO_TENANT_AUTO_BOOTSTRAP_ENABLED=true
TWILIO_TENANT_AUTO_PROVISION_ENABLED=false

## Durable WhatsApp inbound turns
# Keep legacy until the migration and the dedicated DB-backed worker are both
# deployed. Queue mode persists signed webhooks before returning 200 and never
# sends raw payloads or phone numbers through a broker.
WHATSAPP_INBOUND_DURABILITY_MODE=legacy
# Dedicated random secret (minimum 32 bytes) used only to HMAC conversation
# identities. Do not reuse or rotate it casually: FIFO stream keys depend on it.
WHATSAPP_INBOUND_HASH_SECRET=
# Tenant-scoped session identity rollout: legacy -> shadow -> enforce.
# Queue mode and production realtime voice require enforce plus this dedicated
# 32+ byte secret. Shadow may temporarily reuse a durable platform secret.
CHANNEL_SESSION_IDENTITY_MODE=legacy
CHANNEL_SESSION_IDENTITY_HMAC_SECRET_V1=
CHANNEL_SESSION_IDENTITY_VERSION_V1=v1
WHATSAPP_INBOUND_MAX_PAYLOAD_BYTES=65536
WHATSAPP_INBOUND_LEASE_SECONDS=180
WHATSAPP_INBOUND_MAX_ATTEMPTS=8
WHATSAPP_INBOUND_WORKER_BATCH_SIZE=8
WHATSAPP_INBOUND_WORKER_POLL_SECONDS=0.5
# Optional only when Celery is initialized and a broker/worker is deployed.
# The standalone DB poller remains the source of truth.
WHATSAPP_INBOUND_CELERY_WAKEUP_ENABLED=false
# Completed inbound payloads are scrubbed atomically. Dead payloads are kept
# only for this bounded diagnostic window (0-720 hours), then scrubbed by job.
WHATSAPP_INBOUND_DEAD_PAYLOAD_RETENTION_HOURS=72
WHATSAPP_INBOUND_PAYLOAD_SCRUB_BATCH_SIZE=200
# Exceptional preservation switch. Invalid values enable the hold fail-closed.
WHATSAPP_INBOUND_PAYLOAD_LEGAL_HOLD=false

# Durable external effects. Core ticket creation/comment and PedidoService order
# paths use this runtime; direct model-write entrypoints remain rollout backlog.
# Keep legacy until the migration, worker and a tenant-scoped staging canary are
# verified end to end.
DOMAIN_EFFECT_OUTBOX_MODE=legacy
DOMAIN_EFFECT_OUTBOX_SECRET=
DOMAIN_EFFECT_OUTBOX_TENANT_IDS=
DOMAIN_EFFECT_OUTBOX_MAX_PAYLOAD_BYTES=4096
DOMAIN_EFFECT_OUTBOX_LEASE_SECONDS=180
DOMAIN_EFFECT_OUTBOX_MAX_ATTEMPTS=8
DOMAIN_EFFECT_OUTBOX_WORKER_BATCH_SIZE=20
DOMAIN_EFFECT_OUTBOX_WORKER_POLL_SECONDS=0.5
DOMAIN_EFFECT_OUTBOX_CELERY_WAKEUP_ENABLED=false
# Dedicated survey-response effect poller. This is intentionally separate
# from DOMAIN_EFFECT_OUTBOX because it owns a different table and executor.
SURVEY_RESPONSE_EFFECT_LEASE_SECONDS=120
SURVEY_RESPONSE_EFFECT_WORKER_BATCH_SIZE=50
SURVEY_RESPONSE_EFFECT_WORKER_MAX_TENANTS_PER_CYCLE=50
SURVEY_RESPONSE_EFFECT_WORKER_POLL_SECONDS=0.5
# Dedicated stable HMAC key for source-anonymous response uniqueness. Minimum
# 32 random bytes. Never expose it client-side or rotate it in-place: publish a
# new survey/privacy generation when introducing a new key version.
SURVEY_IDENTITY_HMAC_SECRET_V1=
# Opaque eligibility grants for institution_attested/manual_review releases.
# All three controls are required: strict opt-in, explicit positive tenant IDs,
# and a dedicated random secret of at least 32 bytes. Keep disabled until the
# migration and a controlled tenant smoke are complete.
ENABLE_SURVEY_ELIGIBILITY_GRANTS_V1=false
SURVEY_ELIGIBILITY_GRANT_TENANT_IDS=
SURVEY_ELIGIBILITY_SECRET_V1=
# Durable Workflow Studio control plane. This persists append-only drafts,
# reviews, versions and activations, but never binds them to the live runtime.
# Apply the migration first, then opt in only explicit tenant IDs.
ENABLE_WHATSAPP_WORKFLOW_STUDIO_DURABLE_V1=false
WHATSAPP_WORKFLOW_STUDIO_DURABLE_TENANT_IDS=
# Public source-anonymous live results hide any option, minute or map surface
# containing 1..k-1 participants. Keep >=3; 5 is the conservative default.
SURVEY_PUBLIC_MIN_CELL_SIZE=5
# Institutional survey truth boundary. The safe default observes without
# changing public visibility. Enforcement requires an explicit tenant allowlist.
SURVEY_JURISDICTION_GATE_MODE=observe
SURVEY_JURISDICTION_GATE_TENANT_IDS=

## Assessment/interview core v1
# Fail-closed. Enable only after the migration, tenant capability review and a
# controlled staging smoke. The v1 workflow ends at awaiting_human_review and
# cannot admit, reject, hire or decide eligibility.
ENABLE_ASSESSMENT_INTERVIEWS_V1=false
ENABLE_INTERVIEW_ASSIGNMENTS_V1=false
# Shared Socket.IO pub/sub used by non-web emitters. Production survey workers
# fail closed without a reachable Redis/Redis-TLS transport initialized on the
# exact same channel as the web process. Do not reuse a URL implicitly.
SOCKETIO_MESSAGE_QUEUE_URL=
SOCKETIO_MESSAGE_QUEUE_CHANNEL=chatboc-realtime-v1
SOCKETIO_MESSAGE_QUEUE_HEALTHCHECK_TIMEOUT_SECONDS=2
# Email is an independent live-delivery gate. Zoho aliases are accepted by the
# canonical SMTP config, but keep delivery disabled until a controlled smoke.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_REQUIRE_AUTH=true
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
SIGEM_LIVE_ENABLED=false
WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=12
WHATSAPP_MEDIA_MAX_BYTES=26214400

## Optional Render secret sync for generated Twilio subaccount tokens
RENDER_ENV_SYNC_ENABLED=false
RENDER_ENV_SYNC_TRIGGER_DEPLOY_ENABLED=false
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_ENV_GROUP_ID=
