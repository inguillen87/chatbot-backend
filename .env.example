## Core runtime
ENV=dev
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

## AI providers
OPENAI_API_KEY=
OPENAI_CHAT_MODEL_DEFAULT=gpt-4o-mini
LLM_PROVIDER_ORDER=openai,gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_CHAT_API_VERSION=v2
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_ENABLED=false
HUGGINGFACE_PROVIDER=auto
HUGGINGFACE_EMBEDDINGS_ENABLED=false
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-large
HUGGINGFACE_ZERO_SHOT_ENABLED=false
HUGGINGFACE_ZERO_SHOT_MODEL=joeddav/xlm-roberta-large-xnli
HUGGINGFACE_RECLAMO_CATEGORY_MIN_SCORE=0.72
HUGGINGFACE_RECLAMO_PRIORITY_MIN_SCORE=0.66
HUGGINGFACE_RECLAMO_SIGNAL_MIN_SCORE=0.62
HUGGINGFACE_SENTIMENT_MIN_SCORE=0.56
HUGGINGFACE_PYME_INTENT_MIN_SCORE=0.62
VISION_HUGGINGFACE_ENABLED=false
HUGGINGFACE_IMAGE_CLASSIFICATION_MODEL=google/vit-base-patch16-224
HUGGINGFACE_OBJECT_DETECTION_MODEL=facebook/detr-resnet-50
INSTALL_OPEN_SOURCE_AI_EXTRAS=false
DOCLING_ENABLED=false
DOCLING_MAX_FILE_MB=15

## Demo mode (disabled by default; enable explicitly in non-production)
ENABLE_DEMO_MODE=false
DEMO_SESSION_SECRET=replace-with-a-different-long-random-secret

## Clerk Auth
CLERK_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=
# Enable only after each provider is configured in the Chatboc Clerk project.
CLERK_SOCIAL_PROVIDERS=

## WhatsApp welcome template (placeholder)
WELCOME_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WELCOME_MESSAGE_DELAY_SECONDS=5

## Twilio / Meta Tech Provider onboarding
PUBLIC_API_BASE_URL=https://api.chatboc.ar
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_META_APP_ID=
TWILIO_META_EMBEDDED_SIGNUP_CONFIG_ID=
TWILIO_PARTNER_SOLUTION_ID=
TWILIO_TECH_PROVIDER_LIVE_ENABLED=false
TWILIO_TENANT_AUTO_BOOTSTRAP_ENABLED=true
TWILIO_TENANT_AUTO_PROVISION_ENABLED=false

## Optional Render secret sync for generated Twilio subaccount tokens
RENDER_ENV_SYNC_ENABLED=false
RENDER_ENV_SYNC_TRIGGER_DEPLOY_ENABLED=false
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_ENV_GROUP_ID=
